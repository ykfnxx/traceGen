{
  "block_size": 4,
  "duration": 60,
  "max_concurrent_sessions": 3,
  "session_rate": 0.2,
  "bursts": [{"start": 20, "duration": 10, "session_rate": 1.0}],
  "seed": 42,
  "arrival": {"distribution": "gamma", "cv": 1.5},
  "datasets": [
    {"name": "chat", "path": "data/chat.jsonl", "format": "session_jsonl", "weight": 0.6},
    {"name": "agent", "path": "data/agent.jsonl", "format": "weka", "weight": 0.4}
  ]
}
